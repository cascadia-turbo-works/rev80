# ── Fonts (not tracked — fetched by scripts/fetch_font.sh into
#    src/rev80/assets/fonts/ on each dev machine) ─────────────────────────────
src/rev80/assets/fonts/

# ── Data ──────────────────────────────────────────────────────────────────────
DEVDATA/
data/

# ── Logs ──────────────────────────────────────────────────────────────────────
log/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
# Generated by setuptools_scm at build/install time — see [tool.setuptools_scm]
# in pyproject.toml. Not committed: a tracked copy can't reflect a tag applied
# after its own commit.
src/rev80/_version.py
.pytest_cache/
.ruff_cache/
.venv/
.python-version
.vscode
venv/
**/.ipynb_checkpoints/

# ── Generated ─────────────────────────────────────────────────────────────────
installer/version.iss

# ── Build & installer artifacts ───────────────────────────────────────────────
dist/
build/rev80/
installer/Output/
*.spec.bak

# ── Pre-staged PicoSDK binaries (gitignored; sourced from a PicoSDK install) ─
# Place ps4000a.dll + picoipp.dll here, or set PICO_DLL_DIR env var.
# See build/collect_pico_dlls.py for details.
vendor/pico/

# ── Claude Code: share agents, keep machine-local settings out ───────────────
.claude/settings.local.json
.claude/worktrees/
