#!/usr/bin/env sh
# Run ruff and write _version.py before every commit.
# Install once with: git config core.hooksPath .githooks

python -m ruff check vibechecker/ || {
    echo "ruff found issues — fix them or use 'git commit --no-verify' to skip."
    exit 1
}

# GIT_RELEASE_VERSION lets you pin an exact version string on a release commit:
#   GIT_RELEASE_VERSION=rc0.5 git commit -m "chore: release rc0.5"
# Without it, git describe returns the tag name when on an exact tag and
# "<tag>-<N>-g<hash>" when N commits past one.
if [ -n "$GIT_RELEASE_VERSION" ]; then
    VERSION="$GIT_RELEASE_VERSION"
else
    VERSION=$(git describe --tags --always)
fi
printf '# Auto-generated by pre-commit hook — do not edit\n__version__ = "%s"\n' "$VERSION" \
    > vibechecker/_version.py
git add vibechecker/_version.py
