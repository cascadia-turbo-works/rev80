#!/usr/bin/env sh
# Run ruff (blocking) before every commit.
# Install once with: git config core.hooksPath .githooks

# Scope matches .github/workflows/ci.yml exactly (src/ AND tests/).
python -m ruff check src/ tests/ || {
    echo "ruff found issues — fix them or use 'git commit --no-verify' to skip."
    exit 1
}

