#!/usr/bin/env sh
# Run ruff and write _version.py before every commit.
# Install once with: git config core.hooksPath .githooks

python -m ruff check vibechecker/ || {
    echo "ruff found issues — fix them or use 'git commit --no-verify' to skip."
    exit 1
}

VERSION=$(git describe --tags --long --always)
printf '# Auto-generated by pre-commit hook — do not edit\n__version__ = "%s"\n' "$VERSION" \
    > vibechecker/_version.py
git add vibechecker/_version.py
