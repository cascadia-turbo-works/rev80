#!/usr/bin/env sh
# Run ruff (warn-only), write _version.py, and keep doc/*.pdf in sync with
# their Markdown sources before every commit.
# Install once with: git config core.hooksPath .githooks

python -m ruff check src/rev80/ || {
    echo "pre-commit: ruff found issues (see above) — not blocking the commit." >&2
}

VERSION=$(git describe --tags --long --always)
printf '# Auto-generated by pre-commit hook — do not edit\n__version__ = "%s"\n' "$VERSION" \
    > src/rev80/_version.py
git add src/rev80/_version.py

# Renders README.md, CONTRIBUTING.md, doc/PROGRESS.md, and doc/CHANGELOG.md
# (via scripts/render_md.sh) to doc/*.pdf whenever one of them is part of
# this commit, and stages the resulting PDF into the same commit.
DOCS="README.md CONTRIBUTING.md doc/PROGRESS.md doc/CHANGELOG.md"
staged_docs=""
for doc in $DOCS; do
    if git diff --cached --name-only --diff-filter=ACM | grep -qxF "$doc"; then
        staged_docs="$staged_docs $doc"
    fi
done

if [ -n "$staged_docs" ]; then
    if command -v pandoc >/dev/null 2>&1 && command -v weasyprint >/dev/null 2>&1; then
        for doc in $staged_docs; do
            ./scripts/render_md.sh "$doc"
            base=$(basename "$doc")
            pdf="doc/${base%.*}.pdf"
            git add "$pdf"
        done
    else
        echo "pre-commit: pandoc/weasyprint not found — skipping PDF rendering for:$staged_docs" >&2
        echo "pre-commit: install pandoc + weasyprint to keep doc/*.pdf in sync (commit proceeds without it)." >&2
    fi
fi
